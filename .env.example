# Local development only. Keep the public origin aligned with the Vite port.
DATABASE_URL=postgresql://botroost:botroost_dev@127.0.0.1:5432/botroost
BOTROOST_PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000

# Generate with `openssl rand -base64 32`; the decoded value must be 32 bytes.
CREDENTIAL_MASTER_KEY=replace-with-a-generated-base64-key

# Real local Agent. Generate NAPCAT_TOKEN with `openssl rand -hex 32`.
CONTROL_PLANE_URL=http://127.0.0.1:3000
NODE_STATE_DIR=/absolute/path/to/botroost-agent-state
NAPCAT_HOST_STATE_DIR=/absolute/path/to/botroost-agent-state
NAPCAT_TOKEN=replace-with-a-generated-napcat-token
NAPCAT_DOCKER_NETWORK=bridge
AGENT_PROVIDER=napcat
